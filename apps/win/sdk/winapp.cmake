# Building a Windows application module for WINN.EXE.
#
# In the application's CMakeLists.txt (see apps/winapps/demo):
#
#   include(${CMAKE_CURRENT_SOURCE_DIR}/../../win/sdk/winapp.cmake)
#   win_app(DEMO demo.c DESCRIPTION "API Demo" ICON demo.icon)
#
# DESCRIPTION is the name the Program Manager gives the program; ICON a
# text file of 32 lines of 32 characters, one a pixel: "." transparent, or
# the VGA colour 0-F (0 black, 1 maroon, 2 green, 3 olive, 4 navy,
# 5 purple, 6 teal, 7 silver, 8 grey, 9 red, A lime, B yellow, C blue,
# D fuchsia, E aqua, F white); lines starting with "#" are comments.
#
# The result is apps/compiled/<NAME>.EXE: an EZ image whose entry is the
# SDK's __ez_start (no crt0), calling WinMain on its own task. API calls go
# through the export tables of WINN.EXE by Win16 ordinal.

set(WIN_SDK_DIR "${CMAKE_CURRENT_LIST_DIR}")
set(WIN_DIR "${WIN_SDK_DIR}/..")
set(WIN_APPS_ROOT "${WIN_DIR}/../..")

# winapp_info.h for winapp_entry.c from DESCRIPTION and ICON
function(win_app_info_header OUT DESC ICON)
    set(xor "0")
    set(and "0")
    set(has 0)
    if(ICON)
        file(STRINGS "${ICON}" lines)
        set(rows "")
        foreach(l IN LISTS lines)
            string(STRIP "${l}" l)              # a CRLF checkout leaves CRs
            if(NOT l MATCHES "^#" AND NOT l STREQUAL "")
                list(APPEND rows "${l}")
            endif()
        endforeach()
        list(LENGTH rows n)
        if(NOT n EQUAL 32)
            message(FATAL_ERROR "${ICON}: ${n} rows, 32 wanted")
        endif()
        set(xor "")
        set(and "")
        foreach(row IN LISTS rows)
            string(LENGTH "${row}" len)
            if(NOT len EQUAL 32 OR NOT row MATCHES "^[.0-9A-Fa-f]+$")
                message(FATAL_ERROR "${ICON}: bad row \"${row}\"")
            endif()
            # colours: two pixels a byte
            string(REPLACE "." "0" c "${row}")
            string(REGEX REPLACE "(..)" "0x\\1," c "${c}")
            string(APPEND xor "${c}")
            # mask: "." is 1, eight pixels a byte
            string(REGEX REPLACE "[0-9A-Fa-f]" "0" m "${row}")
            string(REPLACE "." "1" m "${m}")
            foreach(i RANGE 0 3)
                math(EXPR at "${i} * 8")
                string(SUBSTRING "${m}" ${at} 8 bits)
                set(v 0)
                foreach(k RANGE 0 7)
                    string(SUBSTRING "${bits}" ${k} 1 b)
                    math(EXPR v "${v} * 2 + ${b}")
                endforeach()
                string(APPEND and "${v},")
            endforeach()
        endforeach()
        set(has 1)
    endif()
    file(WRITE "${OUT}.tmp"
        "/* generated by winapp.cmake */\n"
        "#define WINAPP_DESCRIPTION \"${DESC}\"\n"
        "#define WINAPP_HAS_ICON ${has}\n"
        "#define WINAPP_ICON_XOR ${xor}\n"
        "#define WINAPP_ICON_AND ${and}\n")
    configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
endfunction()

function(win_app NAME)
    cmake_parse_arguments(W "" "DESCRIPTION;ICON" "" ${ARGN})
    set(sources ${W_UNPARSED_ARGUMENTS})
    set(target ${PROJECT_NAME})
    if(NOT W_DESCRIPTION)
        set(W_DESCRIPTION "${NAME}")
    endif()
    if(W_ICON)
        get_filename_component(W_ICON "${W_ICON}" ABSOLUTE)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${W_ICON}")
    endif()
    win_app_info_header("${CMAKE_CURRENT_BINARY_DIR}/winapp_info/winapp_info.h" "${W_DESCRIPTION}" "${W_ICON}")
    add_executable(${target}
        ${sources}
        ${WIN_SDK_DIR}/winapp_entry.c
        ${WIN_SDK_DIR}/winapi_stubs.S
    )
    include(${WIN_APPS_ROOT}/apps/api/native-dos-runtime.cmake)
    native_dos_runtime_attach(${target})
    target_include_directories(${target} PRIVATE
        ${CMAKE_CURRENT_BINARY_DIR}/winapp_info
        ${WIN_DIR}/include
        ${WIN_DIR}/ddi
        ${WIN_APPS_ROOT}/apps/api
    )
    configure_file(${WIN_DIR}/memmap.ld.in ${CMAKE_CURRENT_BINARY_DIR}/memmap.ld @ONLY)
    pico_set_linker_script(${target} ${CMAKE_CURRENT_BINARY_DIR}/memmap.ld)
    pico_set_program_name(${target} "Windows application: ${NAME}")
    target_link_options(${target} PRIVATE -Xlinker --print-memory-usage -r)
    if (CMAKE_C_COMPILER_ID STREQUAL "GNU")
        target_compile_options(${target} PUBLIC -fno-jump-tables -Wall -Wno-unused-parameter)
    endif ()
    target_compile_definitions(${target} PRIVATE ELF_MODE)
    pico_enable_stdio_uart(${target} 0)
    pico_enable_stdio_usb(${target} 0)

    set(compiled "${WIN_APPS_ROOT}/apps/compiled")
    if(WIN32)
        set(elf2ez "${WIN_APPS_ROOT}/tools/elf2ez.exe")
    else()
        set(elf2ez "${WIN_APPS_ROOT}/tools/elf2ez")
    endif()
    add_custom_command(TARGET ${target} POST_BUILD
        COMMAND ${CMAKE_COMMAND}
            -DNM=${CMAKE_NM}
            -DINPUT=$<TARGET_FILE:${target}>
            -DALLOW_UNRESOLVED=__ez_preinit_array_start,__ez_preinit_array_end,__ez_init_array_start,__ez_init_array_end,__ez_fini_array_start,__ez_fini_array_end
            -P ${WIN_DIR}/check_unresolved.cmake
        COMMAND ${CMAKE_COMMAND} -E copy $<TARGET_FILE:${target}> ${compiled}/${NAME}.crt
        COMMAND ${elf2ez} /y ${compiled}/${NAME}.crt
        COMMAND ${CMAKE_COMMAND} -E rm -f ${compiled}/${NAME}.crt
    )
endfunction()
